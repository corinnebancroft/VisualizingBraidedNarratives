<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="buildSvgPage" default="all">
  
  <description>
      This build file runs the process of generating an HTML page containing an
      SVG diagram, which itself is first generated from a CSV file using Matplotlib.
      Another CSV file provides the colours to be used for the narrators and characters.
  </description>
    
    
  
    <property name="echo.separator" value="************************************************"/>
    
    <!-- We'll need access to the date. -->
    <tstamp>
        <format property="today" pattern="yyyy-MM-dd" locale="en,CA"/>
    </tstamp>
    
    <!-- Location of Saxon jar. -->
    <property name="saxon" value="${basedir}/lib/saxon-he-12.jar"/>

    <!-- Location of python interpreter -->
    <property name="python.cmd" value="/Users/COBAN3/VisualizingBraidedNarratives/.venv/bin/python3"/>
    
    <!-- Default values for input properties. -->
    <property name="defGraphTitle" value="Plague of Doves"/>
    <property name="defGraphId" value="pod-tg"/>
    <property name="defInputData" value="PoDTimeGraphApril2.csv"/>
    <property name="defInputColors" value="PoDColorCode.csv"/>
  
  
  <target name="init">
      <description>
          TARGET init
          This just sets things up and asks for required input.
      </description>
      <!-- A title for the graph. -->
      <input message="Please provide a title for this graph: e.g. ${defGraphTitle}"
          addproperty="graphTitle" defaultvalue="${defGraphTitle}"/>
      
      <!-- An id for the graph. -->
      <input message="Please provide an id for the graph, all lower-case, ending in -tg: e.g. ${defGraphId}"
          addproperty="graphId" defaultvalue="${defGraphId}"/>
      
      <!-- These are the two input files to be processed. -->
      <input message="Please type the name of a CSV file in this folder which contains the data for the graph: e.g. ${defInputData}"
          addproperty="inputData" defaultvalue="${defInputData}"/>
      
      <input message="Please type the name of a CSV file in this folder which contains the colour mapping for the graph: e.g. ${defInputColors}"
          addproperty="inputColors" defaultvalue="${defInputColors}"/>
      
      <!-- One of them will be converted to a JSON file. -->
      <basename property="inputDataNoExt" file="${inputData}" suffix=".csv"/>
      <property name="inputJson" value="${inputDataNoExt}.json"/>
      
      <!-- This is the output file we want to create initially. -->
      <property name="outputSvg" value="${inputDataNoExt}.svg"/>
      
      <!-- This is the final HTML file we want to create. -->
      <property name="outputHtml" value="${graphId}.html"/>
  </target>
  
  <target name="generateSvg">
      <description>
          TARGET generateSvg
          This generates an SVG graph using two input CSVs, one of which 
          is the colour map and the other is the narrative data.
      </description>
      <exec executable="${python.cmd}">
          <arg value="generate_svg.py"/>
          <arg value="--in_df=${inputData}"/>
          <arg value="--in_color_df=${inputColors}"/>
          <arg value="--graph_title=${graphTitle}"/>
          <arg value="--graph_id=${graphId}"/>
      </exec>
  </target>
    
    <target name="mplSvgToHtml">
        <description>
            TARGET mplSvgToHtml
            This processes the SVG created in doMatPlotLib using XSLT
            to create an HTML file with embedded JS and CSS.
        </description>
        <java fork="true" classname="net.sf.saxon.Transform" 
            classpath="${saxon}" 
            failonerror="true">
            <jvmarg value="-Xmx2048m"/>
            <jvmarg value="-Djdk.xml.maxParameterEntitySizeLimit=0"/>
            <arg value="-s:${outputSvg}"/>
            <arg value="-xsl:mpl_svg_to_html.xsl"/>
            <arg value="-o:${outputHtml}"/>
            <arg value="baseDir=${basedir}"/>
            <arg value="jsonFile=${inputJson}"/>
            <arg value="graphTitle=${graphTitle}"/>
            <arg value="graphId=${graphId}"/>
            <arg value="--suppressXsltNamespaceCheck:on"/>
        </java>
    </target>
  
  <target name="all" depends="init, generateSvg, mplSvgToHtml">
      <description>
          TARGET all
          This runs the entire process to build an SVG file and then 
          create a web page from it.
      </description>
  </target>
  
</project>